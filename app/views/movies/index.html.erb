<% content_for :title, "Movies" %>

<div class="page-heading">
  <div>
    <p class="eyebrow">RottenPotatoes</p>
    <h1>Movies</h1>
    <p class="subheading">A small collection of movies worth talking about.</p>
  </div>
  <%= link_to "Add a movie", new_movie_path, class: "button" %>
</div>

<% if notice.present? %><p class="notice"><%= notice %></p><% end %>

<div class="table-wrap">
  <table>
    <thead>
      <tr>
        <th scope="col" class="<%= sorted_column_class("title") %>"><%= sort_link("title", "Title") %></th>
        <th scope="col" class="<%= sorted_column_class("rating") %>"><%= sort_link("rating", "Rating") %></th>
        <th scope="col" class="<%= sorted_column_class("release_date") %>"><%= sort_link("release_date", "Release date") %></th>
      </tr>
    </thead>
    <tbody>
      <% @movies.each do |movie| %>
        <tr>
          <td class="<%= sorted_column_class("title") %>"><%= link_to movie.title, movie %></td>
          <td class="<%= sorted_column_class("rating") %>"><%= movie.rating %></td>
          <td class="<%= sorted_column_class("release_date") %>"><%= movie.release_date&.strftime("%b %-d, %Y") %></td>
        </tr>
      <% end %>
    </tbody>
    <tfoot>
      <tr><td colspan="3"><%= pluralize(@movies.size, "movie") %> in the collection</td></tr>
    </tfoot>
  </table>
</div>
